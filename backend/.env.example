PORT=3000
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eventra_db

# JWT — Copia este archivo como .env y define un secreto fuerte y único (mínimo 32 caracteres)
JWT_SECRET=tu_super_secreto_jwt

# OpenAI — Obtén tu clave en https://platform.openai.com/api-keys
# IMPORTANTE: Nunca subas el archivo .env real a GitHub (está en .gitignore)
OPENAI_API_KEY=tu_clave_aqui

# SMTP Gmail — Configuración centralizada de correos (Nodemailer)
# Para Gmail, usar puerto 587 con STARTTLS y una "Contraseña de aplicación" de 16 caracteres
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
SMTP_FROM="EVENTRA <tu_correo@gmail.com>"
EMAIL_SIMULATION_MODE=true
FRONTEND_URL=http://localhost:5173

