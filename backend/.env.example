PORT=3000
DB_USER=postgres
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eventra_db

# JWT — Copia este archivo como .env y define un secreto fuerte y único (mínimo 32 caracteres)
JWT_SECRET=tu_super_secreto_jwt

# Google Gemini AI — Asistente Inteligente Conversacional (EVARA AI)
# Obtén tu clave gratuita en Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=tu_clave_aqui
# Opcional: modelos en orden de preferencia, separados por coma.
# Por defecto: gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-3-flash-preview
GEMINI_MODELS=
# Opcional: tiempo máximo por intento en milisegundos (por defecto 12000)
GEMINI_TIMEOUT_MS=

# OpenAI — (Opcional)
# IMPORTANTE: Nunca subas el archivo .env real a GitHub (está en .gitignore)
OPENAI_API_KEY=tu_clave_aqui

# SMTP — Configuración centralizada de correos (Nodemailer)
# Para servicios con STARTTLS usar puerto 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@dominio.com
SMTP_PASS=tu_contrasena_de_aplicacion
SMTP_FROM="EVENTRA <notificaciones@tuempresa.com>"
EMAIL_SIMULATION_MODE=true
FRONTEND_URL=http://localhost:5173

# Brevo HTTP API (Recomendado para producción/Render: sin bloqueos de puerto SMTP y compatible con cualquier dominio)
BREVO_API_KEY=tu_clave_api_brevo
BREVO_SENDER_EMAIL=notificaciones@tuempresa.com
BREVO_SENDER_NAME="EVENTRA SaaS"

# Resend HTTP API (alternativa a Brevo)
RESEND_API_KEY=
RESEND_FROM="EVENTRA <onboarding@resend.dev>"

# Supabase Storage — comprobantes en bucket PRIVADO (URLs firmadas) y logotipos en bucket público.
# Preparar una vez con: npm run storage:setup (simulación) y luego npm run storage:setup -- --aplicar
SUPABASE_URL=https://tu-proyecto.supabase.co
# Usa la service_role key (solo en el backend, nunca en el frontend)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
SUPABASE_ANON_KEY=
# Opcionales: nombres de buckets y vigencia (segundos) de las URLs firmadas de comprobantes
SUPABASE_BUCKET_COMPROBANTES=comprobantes
SUPABASE_BUCKET_LOGOS=logos
COMPROBANTES_URL_TTL_SEG=900

# Seguridad
# Orígenes permitidos por CORS, separados por coma. Vacío = abierto (solo desarrollo).
CORS_ORIGINS=http://localhost:5173
# true = verifica el certificado SSL de Postgres (requiere el CA de Supabase)
DB_SSL_REJECT_UNAUTHORIZED=false
NODE_ENV=development
