# =============================================================================
# EVENTRA Frontend — Variables de Entorno de Ejemplo
# =============================================================================
# Copia este archivo como .env o .env.local para configurar tu entorno local.
#
# URL base para la API REST del backend de EVENTRA:
# - Desarrollo local: http://localhost:3000/api
# - Entorno Staging:  https://<tu-servicio-staging>.onrender.com/api
#
# IMPORTANTE: No se utiliza una URL de producción como fallback silencioso.
# =============================================================================
VITE_API_URL=http://localhost:3000/api
